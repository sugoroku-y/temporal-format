{
  "name": "temporal-format",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.m js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "rolldown": "rolldown -c",
    "vite": "vite build",
    "tsc": "tsc -p tsconfig.test.json --noEmit --incremental false --composite false",
    "vitest": "vitest run",
    "eslint": "eslint .",
    "prettier": "prettier --write .",
    "typedoc": "typedoc",
    "pre-test": "run-p tsc eslint",
    "main-test": "npm run vitest",
    "test": "run-s pre-test main-test",
    "main-build": "npm run vite",
    "post-build": "run-p rolldown typedoc",
    "build": "run-s main-build post-build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.7",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.6.0",
    "eslint-config-flat-gitignore": "^2.3.0",
    "eslint-plugin-es-x": "^9.7.0",
    "eslint-plugin-import-x": "^4.17.0",
    "globals": "^17.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "rolldown": "^1.1.3",
    "rolldown-plugin-dts": "^0.23.2",
    "temporal-polyfill-lite": "^0.4.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.7"
  }
}

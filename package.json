{
  "name": "temporal-format",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "rolldown": "rolldown -c",
    "vite": "vite build",
    "tsc": "tsc -p tsconfig.test.json --noEmit --incremental false --composite false",
    "vitest": "vitest run",
    "cspell": "cspell . --no-progress",
    "eslint": "eslint .",
    "prettier": "prettier --write .",
    "typedoc": "typedoc",
    "pre-test": "run-p tsc eslint cspell",
    "main-test": "npm run vitest",
    "test": "run-s pre-test main-test",
    "main-build": "npm run vite",
    "post-build": "run-p rolldown typedoc",
    "build": "run-s main-build post-build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.7",
    "cspell": "^9.8.0",
    "eslint": "^10.6.0",
    "eslint-config-flat-gitignore": "^2.3.0",
    "eslint-plugin-es-x": "^10.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.4",
    "rolldown": "^1.1.4",
    "rolldown-plugin-dts": "^0.27.1",
    "temporal-polyfill-lite": "^0.4.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.7"
  }
}
